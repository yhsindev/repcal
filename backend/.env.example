# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# === Database (Supabase Postgres) ===
# Where: Supabase dashboard → Project Settings → Database → Connection string
# Use the "URI" tab. Replace [YOUR-PASSWORD] with the password you set.
# IMPORTANT: prefix scheme with "postgresql+asyncpg://" (not "postgresql://")
# because we use the async driver.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# === Discord Bot ===
# Where: discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Optional: scope slash commands to a specific guild for instant sync.
# Without this, global commands take up to 1 hour to propagate.
# To get the ID: enable Developer Mode in Discord → right-click your server → Copy Server ID
DISCORD_GUILD_ID=

# === Google Gemini (Phase 2+) ===
# Where: aistudio.google.com → Get API key → Create API key in new project
# Not used in Phase 1 — leave blank for now.
GEMINI_API_KEY=

# === App settings ===
APP_ENV=development
LOG_LEVEL=INFO
